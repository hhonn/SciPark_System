# MongoDB (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scipark?retryWrites=true&w=majority

# JWT signing secret (required). Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Email (optional). Without these, OTP and welcome mails are logged, not sent.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_login
EMAIL_PASS=your_brevo_api_key
EMAIL_FROM=noreply@scipark.app

# Server
PORT=3000
NODE_ENV=development

# Extra allowed frontend origins, comma separated.
# Same-origin deployments (backend serves the built frontend) need nothing here.
CLIENT_URL=http://localhost:5173

# Seed passwords. Required when running `npm run seed -- --force` with
# NODE_ENV=production; in development the README defaults are used.
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=
