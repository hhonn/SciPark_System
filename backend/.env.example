# MongoDB (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scipark?retryWrites=true&w=majority

# JWT signing secret (required). Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Email (optional). Without these, OTP and welcome mails are logged, not sent.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_login
EMAIL_PASS=your_brevo_api_key
EMAIL_FROM=noreply@scipark.app

# Or send through Amazon SES with the instance IAM role (no password needed):
# MAIL_TRANSPORT=ses
# AWS_REGION=ap-southeast-2

# Booking requires a verified email when mail is configured above, and not
# otherwise (nobody could receive the code). Override either way:
# REQUIRE_EMAIL_VERIFICATION=true

# Server
PORT=3000
# HOST=127.0.0.1   # only a reverse proxy on this box should reach the app
NODE_ENV=development

# Extra allowed frontend origins, comma separated.
# Same-origin deployments (backend serves the built frontend) need nothing here.
CLIENT_URL=http://localhost:5173

# Set to the number of reverse proxies in front of the app (e.g. 1 behind
# Nginx/Render/Railway). Without it every user appears to come from the
# proxy IP and shares one rate-limit budget.
# TRUST_PROXY=1

# The session cookie is marked Secure only when the request arrived over HTTPS
# (directly, or via a proxy with TRUST_PROXY set). Force it either way with:
# COOKIE_SECURE=true

# Seed passwords. Required when running `npm run seed -- --force` with
# NODE_ENV=production; in development the README defaults are used.
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=
